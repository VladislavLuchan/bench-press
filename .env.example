# --- Database (Turso). Use https:// URL for stateless HTTP; file:local.db for a local file.
TURSO_DATABASE_URL=https://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- LLM (OpenRouter key; used by the scraper for scoring and by the dashboard for cover letters)
LLM_API_KEY=
# Optional override for the cover letter model (dashboard only)
COVER_LETTER_MODEL=anthropic/claude-opus-5

# --- Scraper
# BACKFILL=1 widens LinkedIn's date window to 7 days for a catch-up run.
BACKFILL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional residential proxy. Consumed by Node's built-in fetch when NODE_USE_ENV_PROXY=1.
HTTPS_PROXY=

# --- Dashboard (Vercel)
# Fine-grained GitHub token with Actions: read and write on the repo, for the "Fetch now" button.
GITHUB_TOKEN=
GITHUB_REPO=VladislavLuchan/bench-press
DASHBOARD_TOKEN=change-me-to-a-long-random-string
# Public URL of the dashboard, used in Telegram links.
DASHBOARD_URL=https://your-app.vercel.app
